# =============================================================================
# OpenFoundry Environment Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================================

# --- Database ---
# Matches the postgres service in docker-compose.yml, which publishes 5432 on
# the host as 5434. Unset it to fall back to JSON file storage.
DATABASE_URL=postgresql://openfoundry:openfoundry_dev@localhost:5434/openfoundry

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=openfoundry
S3_SECRET_KEY=openfoundry_dev
S3_BUCKET=openfoundry-media
S3_REGION=us-east-1

# --- Authentication ---
JWT_SECRET=change-me-in-production
TOKEN_EXPIRY_SECONDS=3600

# OAuth clients svc-multipass accepts, as a JSON array - nothing else can sign
# a user in or obtain a client_credentials token. A declaration without a
# clientSecret is a browser client (sign-in page + PKCE) and needs its exact
# redirectUris; one with a clientSecret is a service client and may carry
# platform roles (ADMIN, SERVICE_ACCOUNT). The legacy EDITOR and VIEWER are
# still accepted but deprecated: each is granted as editor or viewer on the
# platform root at startup. Access to one resource is a role granted on it
# (POST /api/v2/admin/resources/<rid>/roles/add). Outside
# NODE_ENV=production the development clients are added to these.
# Single-quote the value. Example:
#   OAUTH_CLIENTS='[{"clientId":"openfoundry-console","redirectUris":["https://console.example.com/login"]},
#                   {"clientId":"sync-job","clientSecret":"<long random>","roles":["SERVICE_ACCOUNT"]}]'
OAUTH_CLIENTS=

# PEM-encoded ES256 key pair svc-multipass signs tokens with. Generate a pair
# with:  openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
#        openssl ec -pubout
# Leave both empty and multipass generates an ephemeral pair at startup, which
# no other process can verify against.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# The gateway verifies every Bearer token against this key - the same PEM as
# JWT_PUBLIC_KEY above. While it is empty the gateway lets every request
# through unauthenticated and logs a warning, which is the demo default and is
# NOT safe for anything reachable from outside your machine.
AUTH_PUBLIC_KEY=

# --- Credentials for scripts, seeds and integration tests ---
# Read by scripts/lib/auth.sh and scripts/lib/auth.ts. Set EITHER a ready-made
# bearer token, OR a client_id/secret pair that they exchange for one against
# ${OPENFOUNDRY_AUTH_URL}/multipass/api/oauth2/token. Leave all three empty and
# no Authorization header is sent, which only works while AUTH_PUBLIC_KEY is
# also empty. Never commit real values: this repository is public.
OPENFOUNDRY_TOKEN=
OPENFOUNDRY_CLIENT_ID=
OPENFOUNDRY_CLIENT_SECRET=
# Defaults to the gateway; override only if tokens come from somewhere else.
OPENFOUNDRY_AUTH_URL=

# Enables POST /api/v2/auth/signup, which mints a signed token for any
# caller-chosen username without persisting a user. OFF unless set to 1/true.
# It creates no account anyone can sign in with; scripts/bootstrap-admin.sh
# creates the first one directly in the database instead.
OPENFOUNDRY_ALLOW_OPEN_SIGNUP=

# --- Service Ports ---
GATEWAY_PORT=8080
ONTOLOGY_PORT=8081
OBJECTS_PORT=8082
ACTIONS_PORT=8083
MULTIPASS_PORT=8084
DATASETS_PORT=8085
COMPASS_PORT=8086
ADMIN_PORT=8087
FUNCTIONS_PORT=8088
WEBHOOKS_PORT=8089
MEDIA_PORT=8090
SENTINEL_PORT=8091

# --- Console ---
CONSOLE_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# --- AIP / LLM ---
AIP_PORT=8092
# Set one of these to enable LLM features (auto-detected):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_URL=http://localhost:11434

# --- Permissions ---
ENFORCE_PERMISSIONS=false

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Tracing ---
TRACING_ENABLED=false
TRACING_ENDPOINT=http://localhost:9411/api/v2/spans

# --- Sanocare / Kelava sync (scripts/sync-kelava*.sh) ---
# Reached through an SSH tunnel; KELAVA_HOST/PORT are the LOCAL end of that tunnel.
KELAVA_HOST=localhost
KELAVA_PORT=5433
KELAVA_DB=
KELAVA_USER=
KELAVA_PASS=
# Real infrastructure addresses - deliberately not stored in this repo.
# Ask the OpenFoundry maintainer; used only to open the tunnel and in help text.
TUNNEL_DB_HOST=
TUNNEL_JUMP_HOST=
